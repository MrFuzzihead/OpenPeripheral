--edit of the pastebin program to get stuff from Github, edited by Vexatos
local tArgs = { ... }

local function printUsage()
    print( "Usages:" )
    print( "github get username/reponame/branch/path <filename>" )
    print( "github run username/reponame/branch/path <arguments>" )
    print( "'github help' for more information" )
end

if not http then
    printError( "Github requires http API" )
    printError( "Set enableAPI_http to true in ComputerCraft.cfg" )
    return
end

local function fetch(url)
    write( "Connecting to github.com... " )
    local response = http.get( url )
    if not response then
        printError( "Failed." )
        return nil
    end

    local body = response.readAll()
    response.close()
    if not body then
        printError( "Failed to read response." )
        return nil
    end

    print( "Success." )
    return body
end

local function get(name, reponame, branch, path)
    return fetch( "https://raw.githubusercontent.com/"..name.."/"..reponame.."/"..branch.."/"..path )
end

local function getFull(path)
    return fetch( "https://raw.githubusercontent.com/"..path )
end

local function save(filename, contents)
    local resolved = shell.resolve( filename )
    if not resolved then
        printError( "Invalid filename: "..tostring( filename ) )
        return false
    end

    if fs.exists( resolved ) then
        print( "File already exists" )
        return false
    end

    local file = fs.open( resolved, "w" )
    if not file then
        printError( "Could not open "..tostring( filename ).." for writing" )
        return false
    end

    file.write( contents )
    file.close()
    print( "Downloaded as "..filename )
    return true
end

local function run( contents, firstArg )
    local func, err = loadstring( contents )
    if not func then
        printError( err )
        return
    end

    setfenv( func, getfenv() )
    local success, msg = pcall( func, unpack( tArgs, firstArg ) )
    if not success then
        printError( msg )
    end
end

local sCommand = tArgs[1]
if sCommand == "get" then
    if #tArgs == 3 then
        local contents = getFull( tArgs[2] )
        if contents then save( tArgs[3], contents ) end
    elseif #tArgs == 6 then
        local contents = get( tArgs[2], tArgs[3], tArgs[4], tArgs[5] )
        if contents then save( tArgs[6], contents ) end
    else
        printUsage()
    end

elseif sCommand == "run" then
    local target = tArgs[2]
    if not target then
        printUsage()
        return
    end

    local localPath = string.find( target, "/", 1, true ) ~= nil
    local contents
    if localPath then
        contents = getFull( target )
    elseif #tArgs >= 5 then
        contents = get( tArgs[2], tArgs[3], tArgs[4], tArgs[5] )
    else
        printUsage()
        return
    end

    if contents then
        run( contents, localPath and 3 or 6 )
    end

elseif sCommand == "help" then
    term.clear()
    print( "github is a program that allows you to get files" )
    print( "from a Github repository and store or run them in your Computer." )
    print( "" )
    printUsage()
    print( "" )
    print( "There is also another spelling:" )
    print( "github get <username> <reponame> <branch> <path> <filename>" )
    print( "github run <username> <reponame> <branch> <path> [arguments]" )
    print( "Note: Do not use the '/' (slash) character with this spelling, except in <path>!" )
else
    printUsage()
end
