<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- FML populates @Instance fields by reflection; they cannot be final. -->
    <Match>
        <Class name="openperipheral.OpenPeripheralCore"/>
        <Field name="instance"/>
        <Bug pattern="MS_SHOULD_BE_FINAL"/>
    </Match>
</FindBugsFilter>
